# Agent's EVM private key (hex, with or without 0x prefix)
# Fund this wallet with ETH (for gas) from https://faucet.triangleplatform.com/arbitrum/sepolia
# Then call MockUSDC.mint(agentWallet, amount) to give it USDC to spend
AGENT_PRIVATE_KEY=0x...

# PayClaw backend
CLAWPAY_API_URL=http://localhost:8000
CLAWPAY_API_KEY=your-clawpay-api-key

# Deployed contract addresses (from your deployment)
USDC_CONTRACT_ADDRESS=0xFCABF780284B0d5997914C5b1ab7Ac34F0F01eaE
ESCROW_CONTRACT_ADDRESS=0x9ee0141d3FD09E4C15D183bD5017ef86e37b4254

# Arbitrum Sepolia RPC (can override for custom node)
ARB_RPC=https://arbitrum-sepolia-testnet.api.pocket.network
CHAIN_ID=421614
